# The domain people use to reach this server. Caddy gets a TLS certificate
# for it automatically (ports 80 and 443 must be reachable from the internet).
# For a quick local try-out use "localhost": Caddy then uses its own local CA.
DATROPE_DOMAIN=chat.example.com

# Database password. Letters and digits only: it is placed in a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Secret shared by the server and LiveKit (voice and video). At least 32
# characters, letters and digits only, for example the output of:
#   openssl rand -hex 32
# The server refuses to start until this is set.
LIVEKIT_API_SECRET=change-me

# Lets admins update and restart the server from Server settings → Updates. The updater
# container that does this has full control of Docker on this machine (root-equivalent);
# it publishes no ports and accepts only requests carrying this token, which only the Datrope
# server has. Leave empty to turn it off (the System page and yt-dlp updates work either
# way). For example: openssl rand -hex 32
DATROPE_UPDATER_TOKEN=
